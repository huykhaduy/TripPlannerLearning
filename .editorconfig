root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4
# Prefer file-scoped namespaces, var when type is apparent, expression bodies.
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true

[*.{js,jsx,ts,tsx,json,css,html,yml,yaml}]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 2
