# Copy to `.env` and fill in your own API keys.
Geoapify__ApiKey=
Serper__ApiKey=

# Required — signs and validates JWTs. Must be at least 32 chars; any random
# string works for local dev, e.g.:
#   PowerShell: -join ((1..48) | % { '{0:X2}' -f (Get-Random -Maximum 256) })
#   bash:       openssl rand -hex 48
Jwt__Key=

# Gmail SMTP for F4/US2 email verification. Requires a Google Account App
# Password (myaccount.google.com/apppasswords) — needs 2-Step Verification
# enabled first; your normal account password will NOT work here.
Smtp__User=
Smtp__AppPassword=

# Dev-server URLs. Code falls back to these same localhost values if unset —
# only override when you change ports or deploy somewhere else.
Cors__AllowedOrigins__0=http://localhost:5173
App__FrontendBaseUrl=http://localhost:5173
Geoapify__BaseUrl=https://api.geoapify.com/
Serper__BaseUrl=https://google.serper.dev/

# Required — the app has no other database. Matches docker-compose.yml's
# default creds; run `docker compose up -d` (or point at your own Postgres).
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=tripplanner;Username=tripplanner;Password=tripplanner

# Cache backend: "Memory" (default, no dependency) or "Redis". Uncomment both
# lines below to switch. ConnectionStrings__Redis matches docker-compose.yml's
# default port; connectTimeout/syncTimeout/connectRetry bound each cache
# operation to ~1s so an unreachable Redis degrades in ~1-2s instead of
# StackExchange.Redis's ~5s+ default backlog timeout (compounding across the
# several cache calls one request can trigger).
# Cache__Provider=Redis
# ConnectionStrings__Redis=localhost:6379,connectTimeout=1000,syncTimeout=1000,connectRetry=1

# Everything below has a working default baked into the settings classes
# (JwtSettings/SmtpSettings/etc. in TripPlanner.Infrastructure) — uncomment
# only to override.
# Jwt__Issuer=TripPlanner
# Jwt__Audience=TripPlannerClient
# Jwt__ExpiryMinutes=60
# Smtp__Host=smtp.gmail.com
# Smtp__Port=587
