<Project Sdk="Microsoft.NET.Sdk">

  <!--
    APPLICATION LAYER
    Use cases / business workflows. Depends ONLY on the Domain layer.
    It defines INTERFACES (e.g. IPasswordHasher, IJwtTokenGenerator, and one
    repository per aggregate: IUserRepository, ITripRepository, IDestinationRepository)
    that the Infrastructure layer implements. This is the Dependency Inversion
    Principle in action — the inner layer owns the contract.
  -->
  <ItemGroup>
    <ProjectReference Include="..\TripPlanner.Domain\TripPlanner.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core only: validators are held as shared instances, not resolved from DI,
         so FluentValidation.DependencyInjectionExtensions is no longer needed. -->
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <!-- Abstractions only, and solely so AddApplication() can extend
         IServiceCollection. Note what is NOT here and must stay that way: no
         logging (every failure is logged by the adapter that owns it), no
         System.Text.Json, no caching abstractions — those are technologies, and
         this layer only knows the ports in Common/Interfaces. Pinned to 10.0.9
         to match the Extensions packages the other projects use. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
  </ItemGroup>

</Project>
