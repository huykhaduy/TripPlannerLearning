<Project Sdk="Microsoft.NET.Sdk">

  <!--
    INFRASTRUCTURE LAYER
    Implements the interfaces defined in Application using concrete technology:
    EF Core (Postgres), BCrypt password hashing, JWT generation, and the
    external travel API client. Depends on Application (and transitively Domain).
  -->
  <ItemGroup>
    <ProjectReference Include="..\TripPlanner.Application\TripPlanner.Application.csproj" />
  </ItemGroup>

  <!--
    ResilientDistributedCache is internal on purpose: it is a decorator wired up
    inside AddInfrastructure, and nothing outside this assembly should construct
    or name it. Its whole contract is what it swallows versus what it lets
    through, which is only observable by calling it directly — hence this.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="TripPlanner.Application.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.10" />
    <PackageReference Include="StackExchange.Redis" Version="3.0.17" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.1" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10" />
  </ItemGroup>

</Project>
